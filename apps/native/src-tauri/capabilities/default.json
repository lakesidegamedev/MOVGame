{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Lakeside checkout and account pages open in the system browser, never inside the game window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://lakesidegames.net/*" },
        { "url": "https://sim.ahousedividedgame.com/*" }
      ]
    }
  ]
}
